# Copy to .env and adjust before: docker compose up --build
# Do not commit .env (real secrets).

# MySQL (app connects with DB_USERNAME / DB_PASSWORD)
DB_USERNAME=employee
DB_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Spring prod profile (docker-compose sets DB_URL to the mysql service)
JWT_SECRET=change-me-docker-jwt-secret-min-32-chars
APP_USER=admin@docker
APP_PASSWORD=change_me_admin_password
